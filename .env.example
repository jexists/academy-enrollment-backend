# 이 파일을 복사해서 .env를 만들고 값을 채우세요. .env는 GitHub에 올라가지 않습니다.
PORT=4200
# 요청을 받을 프런트 주소 (코어 웹, 어드민). 배포하면 Vercel 주소를 쉼표로 이어 적어요.
FRONTEND_ORIGIN=http://localhost:3200,http://localhost:3201
# PostgreSQL 접속 주소 (Render의 External Database URL). 테이블은 hw2 스키마에 만들어요.
DATABASE_URL=
# 로그인 토큰 서명용 임의 문자열 (예: openssl rand -hex 32)
JWT_SECRET=
# 서버를 처음 켤 때 만들어지는 관리자(원장) 계정
ADMIN_EMAIL=admin@naver.com
ADMIN_PASSWORD=
# 로컬 전용: 로그인 화면에 데모 계정 버튼을 보여 준다. 배포 서버에서는 비워 두거나 false
DEMO_LOGIN=
# 시드로 만드는 데모 계정(강사·학부모·학생)의 비밀번호
DEMO_PASSWORD=
# 문의 챗봇(Dify). 주소는 비우면 https://api.dify.ai/v1, 키(app-...)를 비우면 챗봇이 '준비 중'으로 답해요
DIFY_API_URL=
DIFY_API_KEY=
